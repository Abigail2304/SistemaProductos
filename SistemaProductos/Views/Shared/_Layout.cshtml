
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SistemaProductos</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SistemaProductos.styles.css"
          asp-append-version="true" />

    <style>
        .navbar-personalizada {
            background: linear-gradient(90deg, #e0f2fe, #f0f9ff);
            border-bottom: 2px solid #bae6fd;
            box-shadow: 0 3px 12px rgba(14, 165, 233, 0.10);
        }

        .navbar-personalizada .navbar-brand {
            color: #0369a1;
            font-weight: 750;
            font-size: 22px;
        }

        .navbar-personalizada .nav-link {
            color: #075985 !important;
            font-weight: 600;
            border-radius: 10px;
            padding: 9px 15px;
            margin: 0 4px;
            transition: 0.2s;
        }

        .navbar-personalizada .nav-link:hover {
            background: #bae6fd;
            color: #075985 !important;
        }

        .navbar-personalizada .nav-link i {
            margin-right: 5px;
        }

        .footer-personalizado {
            background: #f0f9ff;
            border-top: 1px solid #bae6fd;
            color: #64748b;
        }

        .footer-personalizado a {
            color: #0284c7;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-personalizada mb-3">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-box-seam-fill"></i>
                    SistemaProductos
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                <i class="bi bi-shield-lock-fill"></i>
                                Privacy
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Productos"
                               asp-action="Index">
                                <i class="bi bi-box-seam"></i>
                                Productos
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-personalizado py-3 mt-4">
        <div class="container">
            &copy; 2026 - SistemaProductos -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>